[Unit]
Description=History Cache Agent (R2 cache reader for cloud_gateway_v2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/history-cache/bin/history-cache-agent \
  --socket /run/history-cache/agent.sock \
  --credentials-file /etc/history-cache/credentials.json \
  --foreground-network yes \
  --pack-cache-bytes 33554432
Restart=always
RestartSec=5
RuntimeDirectory=history-cache
RuntimeDirectoryMode=0755

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/history-cache
PrivateTmp=true
CPUQuota=25%
CPUWeight=10
MemoryHigh=96M
MemoryMax=128M
MemorySwapMax=0
TasksMax=32
LimitNOFILE=256
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
