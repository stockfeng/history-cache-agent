# Host-side operations scripts directory, not the Agent container filesystem.
HISTORY_CACHE_OPS=/opt/history-cache/docker
# Leave empty for local JSON/Prometheus only. Credentials are never placed here.
HISTORY_CACHE_ALERT_OPTIONS=
# Optional after configuring a private HTTPS notification endpoint:
# HISTORY_CACHE_ALERT_OPTIONS="--webhook-config /etc/history-cache/webhook.json"
